# build.ninja: the field's and robots' models, and the gate for this folder's Python.
#
# `ninja model` fetches goBILDA's StarterBot STEP and FIRST's field STEP into media/cad/, checks
# their hashes, and converts them by mujocobiobuzz's converter, with robots/starterbot.json and
# fields/biobuzz.json, to models/starterbot/ and models/biobuzz/. Neither is in git.
#
# `ninja check` = ruff check + ruff format --check + mypy + pytest, through `uv run`.

rule check
  command = uv run ruff check . && uv run ruff format --check . && uv run mypy && uv run pytest -q
  description = ruff, ruff format, mypy, pytest

rule fetch
  command = curl -fsSL $url -o $zip.part && echo "$sha256  $zip.part" | shasum -a 256 -c - && mv $zip.part $zip && unzip -o -q $zip -d media/cad && touch $out
  description = fetch $url

rule convert
  command = mkdir -p $dir && uv run --group cad python -m mujocobiobuzz.cad $spec $step $dir > $out
  description = convert $step to $dir

build check: check

build media/cad/3200-2627-0004.step: fetch
  url = https://www.gobilda.com/content/step_files/3200-2627-0004.zip
  zip = media/cad/3200-2627-0004.zip
  sha256 = 43cdd0acebcce31afe8b0ed541df06c394ed1624ca8fbcc4cf42c52a774dc673

build models/starterbot/summary.json: convert robots/starterbot.json media/cad/3200-2627-0004.step
  spec = robots/starterbot.json
  step = media/cad/3200-2627-0004.step
  dir = models/starterbot

build media/cad/field-cad-step.step: fetch
  url = https://ftc-resources.firstinspires.org/ftc/archive/2027/field/field-cad-step
  zip = media/cad/field-cad-step.zip
  sha256 = 5e768b731f1ec8dcd14debba53225c43718877923c351ce08504305f68f7fe00

build models/biobuzz/summary.json: convert fields/biobuzz.json media/cad/field-cad-step.step
  spec = fields/biobuzz.json
  step = media/cad/field-cad-step.step
  dir = models/biobuzz

build model: phony models/starterbot/summary.json models/biobuzz/summary.json

default check
