@@ -8,3 +12,69 @@
 // When on L135S030, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s030
 // for what to write in this file.
+// 'public' so L140's OpModes, in another package, can use it.
+public class OptionMenu {
+
+    private ArrayList<MenuRow> rows = new ArrayList<>();
+    private int pointedIndex = 0;
+
+    public void add(MenuRow row) {
+        rows.add(row);
+    }
+
+    public void goUp() {
+        goBack();
+        pointedIndex = pointedIndex - 1;
+        if (pointedIndex < 0) {
+            pointedIndex = rows.size() - 1;
+        }
+    }
+
+    public void goDown() {
+        goBack();
+        pointedIndex = pointedIndex + 1;
+        if (pointedIndex == rows.size()) {
+            pointedIndex = 0;
+        }
+    }
+
+    public void goRight() {
+        rows.get(pointedIndex).goRight();
+    }
+
+    public void goLeft() {
+        rows.get(pointedIndex).goLeft();
+    }
+
+    public void select() {
+        rows.get(pointedIndex).select();
+    }
+
+    public void goBack() {
+        rows.get(pointedIndex).goBack();
+    }
+
+    public String getSummary() {
+        String summary = "";
+        String between = "";
+        for (MenuRow row : rows) {
+            summary = summary + between + row.getSelected().getShortName();
+            between = "-";
+        }
+        return summary;
+    }
+
+    public ArrayList<String> getLines() {
+        ArrayList<String> lines = new ArrayList<>();
+        lines.add(getSummary());
+        MenuRow pointed = rows.get(pointedIndex);
+        for (MenuRow row : rows) {
+            String pointer = "  ";
+            if (row == pointed) {
+                pointer = "> ";
+            }
+            lines.add(pointer + row.getLine());
+        }
+        return lines;
+    }
+}
