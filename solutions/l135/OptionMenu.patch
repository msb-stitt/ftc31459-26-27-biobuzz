+package org.firstinspires.ftc.teamcode.mytry.l135;
+
+import java.util.ArrayList;
+
 /**
  * The rows of a menu, and which row the pointer is on. Up and down move the
  * pointer, wrap at the ends, and clear the offer in the row it leaves. Left,
@@ -8,3 +12,81 @@
 // When on L135S070, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s070
 // for what to write in this file.
+// 'public' so L140, in another package, can use it. 'public' allows access from any code.
+public class OptionMenu {
+
+    // 'private' so only this class can use it. 'private' allows access from this class only.
+    private ArrayList<MenuRow> rows = new ArrayList<>();
+    // 'private' so only this class can use it. 'private' allows access from this class only.
+    private int pointedIndex = 0;
+
+    // 'public' so L140, in another package, can use it. 'public' allows access from any code.
+    public void add(MenuRow row) {
+        rows.add(row);
+    }
+
+    void goUp() {
+        goBack();
+        pointedIndex = pointedIndex - 1;
+        if (pointedIndex < 0) {
+            pointedIndex = rows.size() - 1;
+        }
+    }
+
+    void goDown() {
+        goBack();
+        pointedIndex = pointedIndex + 1;
+        if (pointedIndex == rows.size()) {
+            pointedIndex = 0;
+        }
+    }
+
+    void goRight() {
+        MenuRow pointedRow = rows.get(pointedIndex);
+        pointedRow.goRight();
+    }
+
+    void goLeft() {
+        MenuRow pointedRow = rows.get(pointedIndex);
+        pointedRow.goLeft();
+    }
+
+    void select() {
+        MenuRow pointedRow = rows.get(pointedIndex);
+        pointedRow.select();
+    }
+
+    void goBack() {
+        MenuRow pointedRow = rows.get(pointedIndex);
+        pointedRow.goBack();
+    }
+
+    String getSummary() {
+        String summary = "";
+        String between = "";
+        for (MenuRow row : rows) {
+            MenuItem selectedItem = row.getSelected();
+            String shortName = selectedItem.getShortName();
+            summary = summary + between + shortName;
+            between = "-";
+        }
+        return summary;
+    }
+
+    ArrayList<String> getLines() {
+        ArrayList<String> lines = new ArrayList<>();
+        String summary = getSummary();
+        lines.add(summary);
+        MenuRow pointedRow = rows.get(pointedIndex);
+        for (MenuRow row : rows) {
+            String pointer = "  ";
+            if (row == pointedRow) {
+                pointer = "> ";
+            }
+            String rowLine = row.getLine();
+            String pointedLine = pointer + rowLine;
+            lines.add(pointedLine);
+        }
+        return lines;
+    }
+}
