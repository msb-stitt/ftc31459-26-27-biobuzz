+package org.firstinspires.ftc.teamcode.mytry;
+
+import com.qualcomm.robotcore.hardware.Gamepad;
+
+import org.firstinspires.ftc.teamcode.base.Tracker;
+
 /**
  * A menu on the Driver Station, worked with a gamepad between INIT and PLAY,
  * for an OpMode to make as a field and call from init_loop(). The menu and its
@@ -10,3 +16,37 @@
 // When on L135S120, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s120
 // for what to write in this file.
+class L135DriverStationMenu {
+
+    L135OptionMenu optionMenu;
+    L135MenuButtons menuButtons;
+
+    L135DriverStationMenu(L135OptionMenu optionMenu) {
+        this.optionMenu = optionMenu;
+        menuButtons = new L135MenuButtons(optionMenu);
+    }
+
+    void loop(Gamepad gamepad) {
+        menuButtons.loop(gamepad);
+        String summary = optionMenu.summary();
+        Tracker.publish("menu/summary", summary);
+        String[] lines = optionMenu.lines();
+        for (int i = 0; i < lines.length; i++) {
+            Tracker.printToDs(lines[i]);
+        }
+    }
+
+    String chosen(String rowName) {
+        String fullName = optionMenu.chosen(rowName);
+        return fullName;
+    }
+
+    void startAt(String rowName, String fullName) {
+        optionMenu.startAt(rowName, fullName);
+    }
+
+    String summary() {
+        String summary = optionMenu.summary();
+        return summary;
+    }
+}
