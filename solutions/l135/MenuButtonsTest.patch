 // for what to write in this file.
+// 'public' so JUnit can run it. 'public' allows access from any code.
+public class MenuButtonsTest {
+
+    MenuItem red = new MenuItem("R", "Red");
+    MenuItem blue = new MenuItem("B", "Blue");
+    MenuRow allianceRow = new MenuRow("Alliance");
+    MenuItem nothing = new MenuItem("N", "Nothing");
+    MenuItem forward24 = new MenuItem("F24", "Forward 24");
+    MenuRow autoRow = new MenuRow("Auto");
+    OptionMenu optionMenu = new OptionMenu();
+    MenuButtons menuButtons = new MenuButtons(optionMenu);
+    Gamepad gamepad = new Gamepad();
+
+    @Before
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void addTheRows() {
+        allianceRow.add(red);
+        allianceRow.add(blue);
+        autoRow.add(nothing);
+        autoRow.add(forward24);
+        optionMenu.add(allianceRow);
+        optionMenu.add(autoRow);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void theDpadAndAWorkTheMenu() {
+        Gamepad rightHeld = new Gamepad();
+        rightHeld.dpad_right = true;
+        press(rightHeld);
+        Gamepad aHeld = new Gamepad();
+        aHeld.a = true;
+        press(aHeld);
+        Gamepad downHeld = new Gamepad();
+        downHeld.dpad_down = true;
+        press(downHeld);
+        press(rightHeld);
+        press(aHeld);
+        assertEquals("B-F24", optionMenu.getSummary());
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void bClearsTheOffer() {
+        Gamepad rightHeld = new Gamepad();
+        rightHeld.dpad_right = true;
+        press(rightHeld);
+        Gamepad bHeld = new Gamepad();
+        bHeld.b = true;
+        press(bHeld);
+        Gamepad aHeld = new Gamepad();
+        aHeld.a = true;
+        press(aHeld);
+        assertEquals("R-N", optionMenu.getSummary());
+    }
+
+    void press(Gamepad held) {
+        gamepad.copy(held);
+        menuButtons.loop(gamepad);
+        Gamepad letGo = new Gamepad();
+        gamepad.copy(letGo);
+        menuButtons.loop(gamepad);
+    }
+}
