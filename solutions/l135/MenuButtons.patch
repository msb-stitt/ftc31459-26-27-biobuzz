+package org.firstinspires.ftc.teamcode.mytry.l135;
+
+import com.qualcomm.robotcore.hardware.Gamepad;
+
 /**
  * The OpMode loop's work of checking the gamepad's buttons, and telling an
  * {@link OptionMenu} what to do for each press.
@@ -7,3 +11,33 @@
 // When on L135S090, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s090
 // for what to write in this file.
+class MenuButtons {
+
+    // 'private' so only this class can use it. 'private' allows access from this class only.
+    private OptionMenu optionMenu;
+
+    MenuButtons(OptionMenu optionMenu) {
+        this.optionMenu = optionMenu;
+    }
+
+    void loop(Gamepad gamepad) {
+        if (gamepad.dpadUpWasPressed()) {
+            optionMenu.goUp();
+        }
+        if (gamepad.dpadDownWasPressed()) {
+            optionMenu.goDown();
+        }
+        if (gamepad.dpadLeftWasPressed()) {
+            optionMenu.goLeft();
+        }
+        if (gamepad.dpadRightWasPressed()) {
+            optionMenu.goRight();
+        }
+        if (gamepad.aWasPressed()) {
+            optionMenu.select();
+        }
+        if (gamepad.bWasPressed()) {
+            optionMenu.goBack();
+        }
+    }
+}
