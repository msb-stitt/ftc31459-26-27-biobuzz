@@ -6,3 +13,100 @@
 // When on L135S080, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s080
 // for what to write in this file.
+// 'public' so JUnit can run it. 'public' allows access from any code.
+public class L135OptionMenuTest {
+
+    L135MenuItem red = new L135MenuItem("R", "Red");
+    L135MenuItem blue = new L135MenuItem("B", "Blue");
+    L135MenuRow allianceRow = new L135MenuRow("Alliance", red, blue);
+    L135MenuItem nothing = new L135MenuItem("N", "Nothing");
+    L135MenuItem forward24 = new L135MenuItem("F24", "Forward 24");
+    L135MenuItem forwardThenStrafe = new L135MenuItem("FS", "Forward Then Strafe");
+    L135MenuRow autoRow = new L135MenuRow("Auto", nothing, forward24, forwardThenStrafe);
+    L135OptionMenu optionMenu = new L135OptionMenu(allianceRow, autoRow);
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void theMenuStartsWithThePointerOnTheFirstRow() {
+        String[] expected = {"R-N", "> Alliance: <Red>", "  Auto: <Nothing>"};
+        String[] lines = optionMenu.lines();
+        assertArrayEquals(expected, lines);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void rightOffersInTheRowThePointerIsOn() {
+        optionMenu.right();
+        String[] expected = {"R-N", "> Alliance: Blue? A:OK B:Back", "  Auto: <Nothing>"};
+        String[] lines = optionMenu.lines();
+        assertArrayEquals(expected, lines);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void selectChangesTheSummary() {
+        optionMenu.right();
+        optionMenu.select();
+        String summary = optionMenu.summary();
+        assertEquals("B-N", summary);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void downMovesThePointerAndClearsTheOffer() {
+        optionMenu.right();
+        optionMenu.down();
+        String[] expected = {"R-N", "  Alliance: <Red>", "> Auto: <Nothing>"};
+        String[] lines = optionMenu.lines();
+        assertArrayEquals(expected, lines);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void downWrapsFromTheLastRowToTheFirst() {
+        optionMenu.down();
+        optionMenu.down();
+        String[] expected = {"R-N", "> Alliance: <Red>", "  Auto: <Nothing>"};
+        String[] lines = optionMenu.lines();
+        assertArrayEquals(expected, lines);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void upWrapsFromTheFirstRowToTheLast() {
+        optionMenu.up();
+        String[] expected = {"R-N", "  Alliance: <Red>", "> Auto: <Nothing>"};
+        String[] lines = optionMenu.lines();
+        assertArrayEquals(expected, lines);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void leftWrapsToTheLastChoice() {
+        optionMenu.down();
+        optionMenu.left();
+        optionMenu.select();
+        String summary = optionMenu.summary();
+        assertEquals("R-FS", summary);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void chosenGivesTheFullNameSelected() {
+        optionMenu.down();
+        optionMenu.right();
+        optionMenu.select();
+        String alliance = optionMenu.chosen("Alliance");
+        assertEquals("Red", alliance);
+        String auto = optionMenu.chosen("Auto");
+        assertEquals("Forward 24", auto);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void startAtSelectsInTheNamedRow() {
+        optionMenu.startAt("Alliance", "Blue");
+        String alliance = optionMenu.chosen("Alliance");
+        assertEquals("Blue", alliance);
+    }
+}
