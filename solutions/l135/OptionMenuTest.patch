@@ -6,3 +15,90 @@
 // When on L135S070, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s070
 // for what to write in this file.
+// 'public' so JUnit can run it. 'public' allows access from any code.
+public class OptionMenuTest {
+
+    MenuItem red = new MenuItem("R", "Red");
+    MenuItem blue = new MenuItem("B", "Blue");
+    MenuRow allianceRow = new MenuRow("Alliance");
+    MenuItem nothing = new MenuItem("N", "Nothing");
+    MenuItem forward24 = new MenuItem("F24", "Forward 24");
+    MenuItem forwardThenStrafe = new MenuItem("FS", "Forward Then Strafe");
+    MenuRow autoRow = new MenuRow("Auto");
+    OptionMenu optionMenu = new OptionMenu();
+
+    @Before
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void addTheRows() {
+        allianceRow.add(red);
+        allianceRow.add(blue);
+        autoRow.add(nothing);
+        autoRow.add(forward24);
+        autoRow.add(forwardThenStrafe);
+        optionMenu.add(allianceRow);
+        optionMenu.add(autoRow);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void theMenuStartsWithThePointerOnTheFirstRow() {
+        assertLines("R-N", "> Alliance: <Red>", "  Auto: <Nothing>");
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void selectChangesTheSummary() {
+        allianceRow.goRight();
+        allianceRow.select();
+        String summary = optionMenu.getSummary();
+        assertEquals("B-N", summary);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void rightOffersInTheRowThePointerIsOn() {
+        optionMenu.goRight();
+        assertLines("R-N", "> Alliance: Blue? A:OK B:Back", "  Auto: <Nothing>");
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void downMovesThePointerAndClearsTheOffer() {
+        optionMenu.goRight();
+        optionMenu.goDown();
+        assertLines("R-N", "  Alliance: <Red>", "> Auto: <Nothing>");
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void downWrapsFromTheLastRowToTheFirst() {
+        optionMenu.goDown();
+        optionMenu.goDown();
+        assertLines("R-N", "> Alliance: <Red>", "  Auto: <Nothing>");
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void upWrapsFromTheFirstRowToTheLast() {
+        optionMenu.goUp();
+        assertLines("R-N", "  Alliance: <Red>", "> Auto: <Nothing>");
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void leftAndSelectWorkInTheRowThePointerIsOn() {
+        optionMenu.goDown();
+        optionMenu.goLeft();
+        optionMenu.select();
+        assertLines("R-FS", "  Alliance: <Red>", "> Auto: <Forward Then Strafe>");
+    }
+
+    void assertLines(String summaryLine, String allianceLine, String autoLine) {
+        ArrayList<String> expected = new ArrayList<>();
+        expected.add(summaryLine);
+        expected.add(allianceLine);
+        expected.add(autoLine);
+        ArrayList<String> lines = optionMenu.getLines();
+        assertEquals(expected, lines);
+    }
+}
