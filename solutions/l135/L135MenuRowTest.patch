@@ -7,3 +13,75 @@
 // When on L135S050, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l135.html#l135s050
 // for what to write in this file.
+// 'public' so JUnit can run it. 'public' allows access from any code.
+public class L135MenuRowTest {
+
+    L135MenuItem red = new L135MenuItem("R", "Red");
+    L135MenuItem blue = new L135MenuItem("B", "Blue");
+    L135MenuRow allianceRow = new L135MenuRow("Alliance", red, blue);
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void aRowStartsAtItsFirstChoiceSelected() {
+        String line = allianceRow.line();
+        assertEquals("Alliance: <Red>", line);
+        L135MenuItem selected = allianceRow.selected();
+        assertEquals(red, selected);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void rightOffersTheNextChoice() {
+        allianceRow.right();
+        String line = allianceRow.line();
+        assertEquals("Alliance: Blue? A:OK B:Back", line);
+        L135MenuItem selected = allianceRow.selected();
+        assertEquals(red, selected);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void leftWrapsFromTheFirstChoiceToTheLast() {
+        allianceRow.left();
+        String line = allianceRow.line();
+        assertEquals("Alliance: Blue? A:OK B:Back", line);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void rightWrapsFromTheLastChoiceToTheFirst() {
+        allianceRow.right();
+        allianceRow.select();
+        allianceRow.right();
+        String line = allianceRow.line();
+        assertEquals("Alliance: Red? A:OK B:Back", line);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void selectSelectsTheChoiceOffered() {
+        allianceRow.right();
+        allianceRow.select();
+        String line = allianceRow.line();
+        assertEquals("Alliance: <Blue>", line);
+        L135MenuItem selected = allianceRow.selected();
+        assertEquals(blue, selected);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void backClearsTheOffer() {
+        allianceRow.right();
+        allianceRow.back();
+        String line = allianceRow.line();
+        assertEquals("Alliance: <Red>", line);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void startAtSelectsTheChoiceWithThatFullName() {
+        allianceRow.startAt("Blue");
+        String line = allianceRow.line();
+        assertEquals("Alliance: <Blue>", line);
+    }
+}
