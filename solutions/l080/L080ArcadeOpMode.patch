@@ -79,10 +79,32 @@ public class L080ArcadeOpMode extends CorbelsTeleOp {
         // When on L080S030, see
         // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l080.html#l080s030
         // for what to do here.
+        double band = 0.05;
+        double forward = deadband(-leftStickY, band);
+        forward = signedSquared(forward);
+        Tracker.publish("arcade/forward", forward);
+        double turn = deadband(-rightStickX, band);
+        turn = signedSquared(turn);
+        Tracker.publish("arcade/turn", turn);
 
         // When on L080S040, see
         // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l080.html#l080s040
         // for what to do here.
+        double leftMixedSpeed = forward - turn;
+        double rightMixedSpeed = forward + turn;
+        double leftSize = Math.abs(leftMixedSpeed);
+        double rightSize = Math.abs(rightMixedSpeed);
+        double biggest = Math.max(leftSize, rightSize);
+        biggest = Math.max(1.0, biggest);
+        leftMixedSpeed = leftMixedSpeed / biggest;
+        rightMixedSpeed = rightMixedSpeed / biggest;
+        Tracker.publish("mixedSpeed/left", leftMixedSpeed);
+        Tracker.publish("mixedSpeed/right", rightMixedSpeed);
+
+        hardware.frontLeft.setPower(leftMixedSpeed);
+        hardware.backLeft.setPower(leftMixedSpeed);
+        hardware.frontRight.setPower(rightMixedSpeed);
+        hardware.backRight.setPower(rightMixedSpeed);
 
         boolean buttonA = gamepad1.a;
         Tracker.publish("button/a", buttonA);
