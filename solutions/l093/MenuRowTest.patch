@@ -7,3 +14,76 @@
 // When on L093S040, see
 // https://coding.stitt.cc/ftc-lessons-java/guide/tasks/l093.html#l093s040
 // for what to write in this file.
+// 'public' so JUnit can run it. 'public' allows access from any code.
+public class MenuRowTest {
+
+    MenuItem nothing = new MenuItem("N", "Nothing");
+    MenuItem forward24 = new MenuItem("F24", "Forward 24");
+    MenuItem forwardThenStrafe = new MenuItem("FS", "Forward Then Strafe");
+    MenuRow autoRow = new MenuRow("Auto");
+
+    @Before
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void addTheItems() {
+        autoRow.add(nothing);
+        autoRow.add(forward24);
+        autoRow.add(forwardThenStrafe);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void aRowStartsAtItsFirstChoiceSelected() {
+        String line = autoRow.getLine();
+        assertEquals("Auto: <Nothing>", line);
+        MenuItem selected = autoRow.getSelected();
+        assertEquals(nothing, selected);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void rightOffersTheNextChoice() {
+        autoRow.goRight();
+        String line = autoRow.getLine();
+        assertEquals("Auto: Forward 24? A:OK B:Back", line);
+        MenuItem selected = autoRow.getSelected();
+        assertEquals(nothing, selected);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void leftWrapsFromTheFirstChoiceToTheLast() {
+        autoRow.goLeft();
+        String line = autoRow.getLine();
+        assertEquals("Auto: Forward Then Strafe? A:OK B:Back", line);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void rightWrapsFromTheLastChoiceToTheFirst() {
+        autoRow.goRight();
+        autoRow.goRight();
+        autoRow.goRight();
+        String line = autoRow.getLine();
+        assertEquals("Auto: <Nothing>", line);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void selectSelectsTheChoiceOffered() {
+        autoRow.goRight();
+        autoRow.select();
+        String line = autoRow.getLine();
+        assertEquals("Auto: <Forward 24>", line);
+        MenuItem selected = autoRow.getSelected();
+        assertEquals(forward24, selected);
+    }
+
+    @Test
+    // 'public' so JUnit can run it. 'public' allows access from any code.
+    public void backClearsTheOffer() {
+        autoRow.goRight();
+        autoRow.goBack();
+        String line = autoRow.getLine();
+        assertEquals("Auto: <Nothing>", line);
+    }
+}
