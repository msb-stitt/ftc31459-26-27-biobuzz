sequenceDiagram
    participant OpMode as AutoWith<br/>MenuOpMode
    participant DS as menu:<br/>Driver<br/>StationMenu
    participant Buttons as menuButtons:<br/>MenuButtons
    participant Menu as optionMenu:<br/>OptionMenu
    participant Tracker as Tracker
    OpMode->>DS: loop(gamepad1)
    DS->>Buttons: loop(gamepad1)
    DS->>Menu: getSummary()
    Menu-->>DS: "R-N"
    DS->>Tracker: publish("menu/summary",<br/>summary)
    DS->>Menu: getLines()
    Menu-->>DS: lines
    DS->>Tracker: printToDs(line),<br/>for each line
