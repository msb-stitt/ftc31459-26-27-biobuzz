; rinohtype's Sphinx style sheet, with the answer pages' diffs in 7 pt type, where other code is
; 9 pt, so a diff's lines fit the page. tools/answers.py gives each diff the class answer-diff.
[STYLESHEET]
name=Corbels answers
base=sphinx

; ++ outranks the base sheet's own +CodeBlock rule for code blocks.
[answer diff : ++CodeBlock(has_class='answer-diff')]
base=code block
font_size=7pt

; The front page's title in 22 pt, where the base sheet's 25 pt wraps it on a 7 in line.
[title page title]
font_size=22pt
