# Everything the guide checks: `ninja book`.
#
# Run it with book/.venv active, or with any Python that has
# book/requirements.txt installed: the Sphinx build and the reading-level check
# both need it.
#
# `ninja -k 0 book` runs every check even when the first fails, which is what
# you want when fixing rather than gating.
#
# Each check is a script under tools/ rather than a one-liner here, because its
# scope rule is worth reading. No output is declared, which is how ninja is told
# to run them all on every invocation.

ninja_required_version = 1.10

# `python`, not `python3`: the guide's venv and every CI runner provide it, and
# `python3` does not exist on Windows. The import path is set by tools/run.py
# rather than by an inline PYTHONPATH, which is shell syntax that Windows `cmd`
# reads as the name of a program to run.
py = python
run = $py tools/run.py

# One book per edge: Windows runs a ninja command without a shell, so `&&`
# would reach sphinx-build as an argument.
rule sphinx
  command = sphinx-build -W $tags -b html source $dir
  description = the $book book builds, with every warning an error
  pool = console

rule wrap
  command = $run check_wrap
  description = prose wrapped at 100 columns
  pool = console

rule reading
  command = $run check_reading_level
  description = student pages at grade 8 or below
  pool = console

rule keep
  command = $run check_keep
  description = kept passages unchanged
  pool = console

rule words
  command = $run check_words
  description = pages under their word ceilings
  pool = console

rule answers
  command = $run answers --check
  description = answer pages match the applied patches
  pool = console

rule figures
  command = $run check_figures
  description = pencilled figures match FIGURES.md
  pool = console

rule cheatsheet
  command = $run cheatsheet --check
  description = the cheat sheet matches the applied patches
  pool = console

build check-sphinx-student: sphinx | source/conf.py
  book = student
  tags =
  dir = build/html
build check-sphinx-mentor: sphinx | source/conf.py
  book = mentor
  tags = -t mentor
  dir = build/mentor
build check-sphinx: phony check-sphinx-student check-sphinx-mentor
build check-wrap: wrap | tools/check_wrap.py tools/bookpaths.py
build check-reading: reading | tools/check_reading_level.py tools/bookpaths.py
build check-keep: keep | tools/check_keep.py tools/register.py keep.toml
build check-words: words | tools/check_words.py tools/register.py keep.toml
build check-figures: figures | tools/check_figures.py tools/bookpaths.py FIGURES.md
build check-answers: answers | tools/answers.py tools/applied.py tools/register.py keep.toml
build check-cheatsheet: cheatsheet | tools/cheatsheet.py tools/answers.py tools/applied.py $
    tools/register.py keep.toml

build book: phony check-sphinx check-wrap check-reading check-keep check-words check-figures $
    check-answers check-cheatsheet review

default book

# A view of what each blank asks a student to write, published beside the
# books. Part of `ninja book`, because building it checks that the changes,
# applied one at a time, rebuild what each patch left. Its pages are generated
# and not committed.
rule diffs
  command = $run diffs --build
  description = what the student writes, one blank at a time
  pool = console

build review: diffs | tools/diffs.py tools/answers.py tools/register.py keep.toml
